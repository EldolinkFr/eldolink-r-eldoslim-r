{
    "name": "eldo/eldoslim",
    "type": "project",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^7.1.3",
        "doctrine/doctrine-migrations-bundle": "^3.1",
        "eldolink/main-bundle": "4.4.x-dev",
        "eldolink/pages-bundle": "4.4.x-dev",
        "eldolink/tools-bundle": "4.4.x-dev",
        "phpdocumentor/reflection-docblock": "^5.3",
        "phpstan/phpdoc-parser": "^1.23",
        "symfony/apache-pack": "^1.0",
        "symfony/console": "^4.0",
        "symfony/dotenv": "^5.4",
        "symfony/flex": "^1.20",
        "symfony/webpack-encore-bundle": "1.7.2"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^3.4",
        "phpunit/phpunit": "^9.5",
        "rector/rector": "^0.12.16",
        "symfony/browser-kit": "^4.0",
        "symfony/css-selector": "^4.0",
        "symfony/debug-bundle": "^4.0",
        "symfony/maker-bundle": "^1.0",
        "symfony/phpunit-bridge": "^6.0",
        "symfony/stopwatch": "^4.0",
        "symfony/web-profiler-bundle": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install --symlink --relative %PUBLIC_DIR%": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url":  "git@bitbucket.org:alexdurand/eldolink-r-main-bundle.git"
        },
        {
            "type": "vcs",
            "url":  "git@bitbucket.org:alexdurand/eldolink-r-pages-bundle.git"
        },
        {
            "type": "vcs",
            "url":  "git@bitbucket.org:alexdurand/eldolink-r-tools-bundle.git"
        }
    ]
}
