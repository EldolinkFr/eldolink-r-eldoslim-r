{
    "name": "alex/eldoslim",
    "license": "proprietary",
    "type": "project",
    "autoload": {
        "psr-4": {
            "": "src/",
            "SymfonyStandard\\": "app/"
        },
        "classmap": [ "app/AppKernel.php", "app/AppCache.php" ]
    },
    "require": {
        "php": ">=5.3.9",
        "symfony/symfony": "2.8.36",
        "twig/twig": "2.6.2",
        "doctrine/orm": "^2.4.8",
        "doctrine/doctrine-bundle": "~1.4",
        "symfony/assetic-bundle": "~2.3",
        "symfony/swiftmailer-bundle": "~2.3",
        "symfony/monolog-bundle": "~2.4",
        "sensio/distribution-bundle": "~4.0",
        "sensio/framework-extra-bundle": "3.0.12",
        "incenteev/composer-parameter-handler": "~2.0",
        "twig/extensions": "~1.0",
        "mopa/bootstrap-bundle": "3.3.0",
        "twbs/bootstrap": "3.3.*",
        "bmatzner/fontawesome-bundle": "~4.3",
        "jquery/jquery":  "2.0.*",
        "misd/guzzle-bundle": "dev-master",
        "craue/formflow-bundle": "~2.0",
        "eldolink/pages-bundle": "2.0.23",
        "eldolink/tools-bundle": "2.0.1",
        "eldolink/main-bundle": "2.0.2"
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "jquery/jquery",
                "version": "2.0.2",
                "dist": {
                    "url": "http://code.jquery.com/jquery-2.0.2.js",
                    "type": "file"
                }
            }
        },
        {
            "type": "vcs",
            "url":  "https://alexdurand@bitbucket.org/alexdurand/eldolink-pages-bundle.git"
        },
        {
            "type": "vcs",
            "url":  "https://alexdurand@bitbucket.org/alexdurand/eldolink-toolsbundle.git"
        },
        {
            "type": "vcs",
            "url":  "https://alexdurand@bitbucket.org/alexdurand/eldolink-main-bundle.git"
        }
    ],
    "require-dev": {
        "sensio/generator-bundle": "~2.3",
        "doctrine/doctrine-migrations-bundle": "^1.0",
        "doctrine/doctrine-fixtures-bundle": "2.4.*"
    },
    "scripts": {
        "post-root-package-install": [
            "SymfonyStandard\\Composer::hookRootPackageInstall"
        ],
        "post-install-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::buildBootstrap",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::clearCache",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installAssets",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installRequirementsFile",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::removeSymfonyStandardFiles",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::prepareDeploymentTarget",
            "Mopa\\Bundle\\BootstrapBundle\\Composer\\ScriptHandler::postInstallSymlinkTwitterBootstrap"
        ],
        "post-update-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::buildBootstrap",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::clearCache",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installAssets",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installRequirementsFile",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::removeSymfonyStandardFiles",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::prepareDeploymentTarget",
            "Mopa\\Bundle\\BootstrapBundle\\Composer\\ScriptHandler::postInstallSymlinkTwitterBootstrap"
        ]
    },
    "config": {
        "bin-dir": "bin"
    },
    "extra": {
        "symfony-app-dir": "app",
        "symfony-web-dir": "web",
        "symfony-assets-install": "relative",
        "incenteev-parameters": {
            "file": "app/config/parameters.yml"
        }
    }
}
