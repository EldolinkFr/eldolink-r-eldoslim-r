{
    "name": "eldo/absolusecure",
    "license": "proprietary",
    "type": "project",
    "autoload": {
        "psr-4": {
            "": "src/",
            "SymfonyStandard\\": "app/"
        },
        "classmap": [ "app/AppKernel.php", "app/AppCache.php" ]
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "require": {
        "php": ">=5.3.9",
        "symfony/symfony": "3.4.*",
        "twig/twig": "^1.0||^2.0",
        "doctrine/orm": "^2.4.8",
        "doctrine/doctrine-bundle": "^1.3",
        "symfony/assetic-bundle": "~2.8",
        "symfony/swiftmailer-bundle": "~2.3",
        "symfony/monolog-bundle": "~3.1",
        "sensio/distribution-bundle": "^5.0",
        "sensio/framework-extra-bundle": "3.0.12",
        "incenteev/composer-parameter-handler": "~2.0",
        "twig/extensions": "~1.0",
        "mopa/bootstrap-bundle": "~3.0",
        "twbs/bootstrap": "3.3.*",
        "components/jquery": "2.0.*",
        "components/font-awesome": "^4.7",
        "leafo/scssphp": "^0.8.4",
        "patchwork/jsqueeze": "^2.0",
        "laminas/laminas-zendframework-bridge": "^1.3",
        "craue/formflow-bundle": "~3.0",
        "eldolink/pages-bundle": "3.0.x-dev",
        "eldolink/tools-bundle": "3.0.x-dev",
        "eldolink/main-bundle": "3.0.x-dev"
    },
    "repositories": [
        {
            "type": "vcs",
            "url":  "git@bitbucket.org:alexdurand/eldolink-pages-bundle.git"
        },
        {
            "type": "vcs",
            "url":  "git@bitbucket.org:alexdurand/eldolink-toolsbundle.git"
        },
        {
            "type": "vcs",
            "url":  "git@bitbucket.org:alexdurand/eldolink-main-bundle.git"
        }
    ],
    "require-dev": {
        "sensio/generator-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.0",
        "doctrine/doctrine-fixtures-bundle": "2.4.*"
    },
    "scripts": {
        "post-root-package-install": [
            "SymfonyStandard\\Composer::hookRootPackageInstall"
        ],
        "post-install-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::buildBootstrap",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::clearCache",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installAssets",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installRequirementsFile",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::removeSymfonyStandardFiles",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::prepareDeploymentTarget"
        ],
        "post-update-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::buildBootstrap",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::clearCache",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installAssets",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installRequirementsFile",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::removeSymfonyStandardFiles",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::prepareDeploymentTarget"
        ]
    },
    "config": {
        "bin-dir": "bin",
        "secure-http": false
    },
    "extra": {
        "symfony-app-dir": "app",
        "symfony-bin-dir": "bin",
        "symfony-var-dir": "var",
        "symfony-web-dir": "web",
        "symfony-tests-dir": "tests",
        "symfony-assets-install": "relative",
        "incenteev-parameters": {
            "file": "app/config/parameters.yml"
        },
        "branch-alias": {
            "dev-master": "3.4-dev"
        }
    }
}
