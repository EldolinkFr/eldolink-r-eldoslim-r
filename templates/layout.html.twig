{% extends 'base.html.twig' %}

{% block title %}{{ app_name }}{% endblock %}

{% block metas %}
    <meta name="apple-mobile-web-app-title" content="{{ app_name }}">
	{% block icons %}
    <link href="{{ asset('bundles/eldopages/img/favicon.ico') }}" rel="shortcut icon" />
    <link href="{{ asset('bundles/eldopages/img/apple-touch-icon.png') }}" rel="apple-touch-icon" />
    <link rel="shortcut icon" sizes="16x16" href="{{ asset('bundles/eldopages/img/icon.png'|imagine_filter('local_16x16')) }}">
    <link rel="shortcut icon" sizes="196x196" href="{{ asset('bundles/eldopages/img/icon.png'|imagine_filter('local_196x196')) }}">
    <link rel="apple-touch-icon-precomposed" href="{{ asset('bundles/eldopages/img/icon.png'|imagine_filter('local_152x152')) }}">
	{% endblock icons %}
    <link rel="dns-prefetch" href="//www.absolusecure.com" />
    <link rel="dns-prefetch" href="//fonts.googleapis.com" />
    <link rel="preconnect" href="//fonts.gstatic.com/" crossorigin="anonymous">
    <link rel="preconnect" href="//www.googletagmanager.com" crossorigin="anonymous">
    <link rel="preconnect" href="{{ cdn_url }}" crossorigin="anonymous">
	{% block hrefLangs %}
		{{ render(path("slimdoo_page_hrefLangs", {'request': app.request})) }}
	{% endblock hrefLangs %}
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('bundles/eldopages/assets/css/app_pdv.min.css') }}" />
{% endblock %}

{% block headjs %}
    {{ parent() }}
    <!--[if lt IE 9]>
        <script src="{{ asset('bundles/eldopages/js/html5shiv.js') }}"></script>
        <script src="{{ asset('bundles/eldopages/js/respond.min.js') }}"></script>
    <![endif]-->
{% endblock %}

{% block bodyclass %}{% endblock %}

{% block body %}
<div class="container">
    {% block header %}
        {{ render(path("slimdoo_page_header")) }}
    {% endblock %}
    
    {% block content %}{% endblock %}
</div>
<div class="cookie_consent" data-banner="{{ path('cookie_consent_banner') }}"></div>
{% endblock %}

{% block footer %}
{% endblock %}

{% block javascripts %}
    <script {% if tracking.mb == '1' %}async{% endif %} src="{{ asset('bundles/eldopages/assets/js/app_pdv.' ~ app.request.getLocale() ~ '.min.js') }}"></script>
{% endblock %}